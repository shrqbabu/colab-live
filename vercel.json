{
  "version": 2,
  "name": "cloudshell-colab-manager",
  "rewrites": [
    {
      "source": "/api/(.*)",
      "destination": "/index.js?__path=/api/$1"
    },
    {
      "source": "/(.*)",
      "destination": "/index.js?__path=/$1"
    }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        { "key": "Access-Control-Allow-Credentials", "value": "true" },
        { "key": "Access-Control-Allow-Origin", "value": "*" },
        { "key": "Access-Control-Allow-Methods", "value": "GET,OPTIONS,PATCH,DELETE,POST,PUT" },
        { "key": "Access-Control-Allow-Headers", "value": "X-CSRF-Token, X-Requested-With, Accept, Accept-Version, Content-Length, Content-MD5, Content-Type, Date, X-Api-Version, Authorization, X-VPS-URL, X-API-Secret, X-VPS-Key" }
      ]
    }
  ]
}
