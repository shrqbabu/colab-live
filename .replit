run = "node server.js"
modules = ["nodejs-20"]

[env]
HEADLESS = "true"
PLAYWRIGHT_SKIP_BROWSER_DOWNLOAD = "1"
PUPPETEER_SKIP_CHROMIUM_DOWNLOAD = "true"

[nix]
channel = "stable-24_05"

[deployment]
build = ["sh", "-c", "cd colab-playwright && npm install"]
run = ["sh", "-c", "cd colab-playwright && node server.js"]
deploymentTarget = "cloudrun"

[[ports]]
localPort = 3000
externalPort = 80

