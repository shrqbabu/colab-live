run = "node colab-live/server.js"
modules = ["nodejs-24"]

[env]
HEADLESS = "true"

[nix]
channel = "stable-24_05"

[deployment]
build = ["sh", "-c", "npx playwright install chromium"]
run = ["sh", "-c", "node colab-live/server.js"]
deploymentTarget = "cloudrun"

[[ports]]
localPort = 3000
externalPort = 80
