run = "node server.js"
modules = ["nodejs-24"]

[env]
HEADLESS = "true"
PLAYWRIGHT_BROWSERS_PATH = "0"

[nix]
channel = "stable-24_05"

[deployment]
build = ["sh", "-c", "npm install && npx playwright install chromium"]
run = ["sh", "-c", "node server.js"]
deploymentTarget = "cloudrun"

[[ports]]
localPort = 3000
externalPort = 80
