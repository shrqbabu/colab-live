# ============================================================
# Google Cloud Shell & Colab Automation Configuration (.env)
# ============================================================

# Web Dashboard Admin Credentials
ADMIN_EMAIL=admin@cloudshell.pro
ADMIN_PASSWORD=your_dashboard_password_here

# Server & Automation Settings
PORT=8080
HEADLESS=true
CLOUDSHELL_URL=https://shell.cloud.google.com/?show=terminal
STARTUP_CMD=docker start omniroute
WAIT_AFTER_LOAD_SEC=60
CHECK_INTERVAL_MIN=10
AUTO_START=false

# Google Account Credentials (Optional for automated login script)
GOOGLE_EMAIL=
GOOGLE_PASSWORD=

# Optional Proxy
# HTTPS_PROXY=http://user:pass@host:port
