# Google Cloud Shell 24/7 Automation Configuration
PORT=8080
HEADLESS=true
CLOUDSHELL_URL=https://shell.cloud.google.com/?show=terminal
STARTUP_CMD=docker start omniroute
WAIT_AFTER_LOAD_SEC=60
CHECK_INTERVAL_MIN=10
AUTO_START=true

# Google Login (Optional for automated login script)
GOOGLE_EMAIL=
GOOGLE_PASSWORD=

# Optional Proxy
# HTTPS_PROXY=http://user:pass@host:port
